\examples{
set.seed(33)
n  <- 1000
Pi <- matrix(c(0.9, 0.1, 0.1, 0.9), 2, 2)
z  <- rbinom(n, 1, 0.4)
z_hat <- z
z_hat[z == 0] <- rbinom(sum(z == 0), 1, 0.1)
z_hat[z == 1] <- 1 - rbinom(sum(z == 1), 1, 0.1)
x1 <- rnorm(n)
y  <- -0.5 + 0.8 * z + 0.7 * x1 + rnorm(n, 0, 0.5)
df <- data.frame(y = y, z = factor(z_hat), x1 = x1)

fit <- mclm(y ~ mc(z, Pi) + x1, data = df)
summary(fit)

